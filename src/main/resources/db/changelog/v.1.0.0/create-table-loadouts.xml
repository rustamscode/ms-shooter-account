<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-table-loadouts" author="rustamscode">
        <comment>Создание таблицы loadouts для хранения комплектов вооружения</comment>

        <createTable tableName="loadouts"
                     remarks="Таблица для хранения комплектов вооружения (Loadouts)">
            <column name="id" type="UUID" remarks="Первичный ключ, UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="created_date" type="TIMESTAMP WITHOUT TIME ZONE"
                    remarks="Дата и время создания">
                <constraints nullable="false"/>
            </column>

            <column name="last_modified_date" type="TIMESTAMP WITHOUT TIME ZONE"
                    remarks="Дата и время последнего обновления">
                <constraints nullable="false"/>
            </column>

            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"
                    remarks="Флаг мягкого удаления">
                <constraints nullable="false"/>
            </column>

            <column name="version" type="INT" remarks="Версия для оптимистичных блокировок">
                <constraints nullable="false"/>
            </column>

            <column name="primary_weapon" type="UUID" remarks="ID основного оружия (FK к weapons.id)">
                <constraints nullable="true" foreignKeyName="fk_loadouts_primary_weapon" references="weapons(id)"/>
            </column>

            <column name="secondary_weapon" type="UUID"
                    remarks="ID дополнительного оружия (FK к weapons.id)">
                <constraints nullable="true" foreignKeyName="fk_loadouts_secondary_weapon" references="weapons(id)"/>
            </column>

            <column name="user_id" type="UUID" remarks="Владелец комплекта">
                <constraints nullable="false" foreignKeyName="fk_loadouts_user_id" references="users(id)"/>
            </column>
        </createTable>
    </changeSet>


    <changeSet id="create-loadouts-indexes" author="rustamscode">
        <comment>Создание индексов для таблицы loadouts</comment>

        <createIndex indexName="idx_loadouts_primary_weapon" tableName="loadouts">
            <column name="primary_weapon"/>
        </createIndex>

        <createIndex indexName="idx_loadouts_secondary_weapon" tableName="loadouts">
            <column name="secondary_weapon"/>
        </createIndex>

        <createIndex indexName="idx_loadouts_is_deleted" tableName="loadouts">
            <column name="is_deleted"/>
        </createIndex>

        <createIndex tableName="loadouts" indexName="idx_loadouts_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>